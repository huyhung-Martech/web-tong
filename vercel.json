{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/main.ts"
    }
  },
  "redirects": [
    {
      "source": "/parkland",
      "destination": "https://parkland.salehub.dev",
      "permanent": false
    },
    {
      "source": "/ha-long-xanh",
      "destination": "https://globalgate.salehub.dev",
      "permanent": false
    },
    {
      "source": "/forestia",
      "destination": "https://forestia.salehub.dev",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
