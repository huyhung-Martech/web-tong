{
  "redirects": [
    {
      "source": "/parkland",
      "destination": "/parkland/",
      "permanent": false
    },
    {
      "source": "/ha-long-xanh",
      "destination": "/ha-long-xanh/",
      "permanent": false
    },
    {
      "source": "/forestia",
      "destination": "/forestia/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/parkland/",
      "destination": "https://parkland.salehub.dev/"
    },
    {
      "source": "/parkland/:path*",
      "destination": "https://parkland.salehub.dev/:path*"
    },
    {
      "source": "/ha-long-xanh/",
      "destination": "https://globalgate.salehub.dev/"
    },
    {
      "source": "/ha-long-xanh/:path*",
      "destination": "https://globalgate.salehub.dev/:path*"
    },
    {
      "source": "/forestia/",
      "destination": "https://forestia.salehub.dev/"
    },
    {
      "source": "/forestia/:path*",
      "destination": "https://forestia.salehub.dev/:path*"
    },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
